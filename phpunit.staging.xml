<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Gate B dipatikan untuk seluruh test.
             .env produksi kini bernilai LANDING_PAGE_BUILDER_ENABLED=true
             (Landing Page Builder menjadi homepage utama). Tanpa pin ini,
             test akan mewarisi nilai .env dan baseline "Gate B OFF" -
             yang diuji dozens test - ikut berubah.
             Test yang butuh Gate B ON overriding-nya sendiri lewat
             config(['landing_page_builder.enabled' => true]). -->
        <env name="LANDING_PAGE_BUILDER_ENABLED" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- SQLite in-memory TIDAK dipakai - banyak migration app ini pakai
             raw DB::statement() dengan sintaks khusus MySQL (ALTER TABLE
             MODIFY, dst) yang tidak kompatibel dengan SQLite. Database
             terpisah dari yang dipakai aplikasi sungguhan (lihat .env) -
             RefreshDatabase di TestCase akan migrate:fresh ke sini tiap
             run, jadi data production tidak pernah tersentuh. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="percetakan_erp_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
        <env name="DB_DATABASE" value="testing_db"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD"/>
